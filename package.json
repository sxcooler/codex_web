{
  "name": "codex-remote-web",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server/main.ts",
    "auth:setup": "node scripts/setup-auth.ts",
    "test": "node --test tests/*.test.ts",
    "probe": "node scripts/probe.ts",
    "protocol:generate": "node scripts/generate-protocol.ts",
    "package:portable": "node scripts/package-portable.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@streamdown/code": "1.1.1",
    "fast-xml-parser": "^5.11.1",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "streamdown": "2.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
